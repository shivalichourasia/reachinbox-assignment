generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  SENDING
  SENT
  FAILED
  RESCHEDULED
}

model User {
  id               String            @id @default(uuid())
  googleId         String            @unique
  email            String            @unique
  name             String
  avatarUrl        String?
  createdAt        DateTime          @default(now())
  senders          Sender[]
  slackIntegration SlackIntegration?
  emailJobs        EmailJob[]
}

model Sender {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  name        String
  fromAddress String
  smtpUser    String
  smtpPass    String
  smtpHost    String     @default("smtp.ethereal.email")
  smtpPort    Int        @default(587)
  createdAt   DateTime   @default(now())
  emailJobs   EmailJob[]

  @@index([userId])
}

model EmailJob {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  senderId     String
  sender       Sender      @relation(fields: [senderId], references: [id])
  toAddress    String
  subject      String
  body         String      @db.Text
  scheduledFor DateTime
  status       EmailStatus @default(SCHEDULED)
  bullJobId    String?     @unique
  batchId      String
  attempts     Int         @default(0)
  lastError    String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status])
  @@index([senderId, status])
  @@index([batchId])
  @@index([scheduledFor])
}

model SlackIntegration {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  accessToken String
  webhookUrl  String
  teamName    String?
  connectedAt DateTime @default(now())
}

model RateLimitWindow {
  id         String @id @default(uuid())
  senderId   String
  hourWindow String
  count      Int    @default(0)

  @@unique([senderId, hourWindow])
}
