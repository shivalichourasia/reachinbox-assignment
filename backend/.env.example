PORT=4000
NODE_ENV=development

DATABASE_URL="postgresql://reachinbox:reachinbox@localhost:5432/reachinbox"

REDIS_HOST=localhost
REDIS_PORT=6379

ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-this-to-a-long-random-string

# Google OAuth (create credentials at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173

# Slack app (create at https://api.slack.com/apps) - needs the
# incoming-webhook and chat:write scopes, redirect URL below whitelisted.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/oauth/callback

# ---- Scheduler tuning (all read at runtime, nothing hardcoded) ----
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50
